#!/bin/sh
set -e

#  Construct a Canu seqStore for the HiFi reads.
#
echo "Building seqStore."
/mnt/storage2/users/ahgrosc1/.snakemake-conda/2a26a3f32e8028bc796ac407fffbd24b_/lib/verkko/bin/sqStoreCreate \\
  -o ../0-correction/hifi.seqStore \\
  -minlength 4000 \\
  -homopolycompress \\
  -pacbio-hifi hifi /mnt/storage3b/projects/no_ngsd/ahthapp1_T2T_ONT/assembly/input/T2T04/T2T04.HQ_herro.50x.fastq.gz

/mnt/storage2/users/ahgrosc1/.snakemake-conda/2a26a3f32e8028bc796ac407fffbd24b_/lib/verkko/bin/sqStoreDumpMetaData -stats -S ../0-correction/hifi.seqStore

# make sure we weren't given compressed reads
numTotBP=\`grep  -w "corrected\$" ../0-correction/hifi.seqStore/info.txt |awk '{print \$2}'\`
numCompBP=\`grep -w "corrected-compressed\$" ../0-correction/hifi.seqStore/info.txt |awk '{print \$2}'\`
if [ \$numTotBP -eq \$numCompBP ]; then
   echo "Error, it looks like you provided HPC sequences, please input uncompressed data"
   exit -1
fi

# check that the store has no duplicate read names, correction only keeps the read name up to the first space
count=\`wc -l ../0-correction/hifi.seqStore/readNames.txt |awk '{print \$1}'\`
count_unique=\`cat ../0-correction/hifi.seqStore/readNames.txt|awk '{print \$2}' |sort |uniq |wc -l\`

if [ \$count -ne \$count_unique ]; then
   echo "Error, the input has duplicate IDs:"
   cat ../0-correction/hifi.seqStore/readNames.txt| awk '{print \$2}' | sort |uniq -c |awk '{if (\$1 > 1) print "	"\$0}'
   exit -1
fi

EOF

chmod +x ./buildStore.sh

