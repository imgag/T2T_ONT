cat > ./aligned001.sh <<EOF
#!/bin/sh
set -e

prefix=\$(echo ../3-align/graph.index | sed s/.index//)
echo "Using index from prefix \"\$prefix\""
echo ""

if [ 5000 -gt 0 ]; then
   memwindow="--seeds-mxm-windowsize 5000"
fi

if [ "False" = "False" ]; then
  diploid="--diploid-heuristic 21 31 --diploid-heuristic-cache ../3-align/diploid.index"
fi

/mnt/storage2/users/ahgrosc1/.snakemake-conda/f08cc0a51ac77e174db5daac5135a1f6_/bin/GraphAligner -t 24 -g ../2-processGraph/unitig-unrolled-hifi-resolved.gfa -f ../3-align/split/ont001.fasta.gz -a ../3-align/aligned001.WORKING.gaf \\
  \$diploid \\
  --seeds-mxm-cache-prefix \$prefix \\
  \$memwindow \\
  --seeds-mxm-length 30 \\
  --seeds-mem-count 10000 \\
  --bandwidth 15 \\
  --multimap-score-fraction 0.99 \\
  --precise-clipping 0.85 \\
  --min-alignment-score 5000 \\
  --hpc-collapse-reads \\
  --discard-cigar \\
  --clip-ambiguous-ends 100 \\
  --overlap-incompatible-cutoff 0.15 \\
  --max-trace-count 5 \\
  --mem-index-no-wavelet-tree \\
&& \\
mv -f ../3-align/aligned001.WORKING.gaf ../3-align/aligned001.gaf
EOF

chmod +x ./aligned001.sh

./aligned001.sh > ../3-align/aligned001.err 2>&1
        
