                print $1":"$4+1"-"$5, $2,$3
            }
        }' > results/8-cdr_finder/bed/all_cdrs.bed
        sort -k1,1 results/8-cdr_finder/bed/T2T05_methyl_all_merged.bed  |         join - <(cat results/final/bed/T2T05_complete_cens.bed | sort -k1,1) |         awk -v OFS="\t" '{
