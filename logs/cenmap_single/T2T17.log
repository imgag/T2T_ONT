                new_ctg_end=ctg_len-ctg_st + 1;
                ctg_st=new_ctg_st;
                ctg_end=new_ctg_end;
            }
            status=($8 == "good" || $8 == "") ? "good" : "misassembled";
            if (status != "good") {
                next;
            };
            print ctg_name, ctg_st, ctg_end, adj_name, 0, ort, adj_st, adj_end, "0,0,0"
        }' ;} > results/final/bed/T2T17_complete_correct_cens.bed 2> logs/9-get_complete_correct_cens/get_complete_correct_bed_T2T17.log
        

