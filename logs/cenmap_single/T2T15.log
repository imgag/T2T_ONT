    output: results/final/bed/T2T15_complete_correct_cens.bed
    log: logs/9-get_complete_correct_cens/get_complete_correct_bed_T2T15.log
    jobid: 117
    reason: Missing output files: results/final/bed/T2T15_complete_correct_cens.bed; Input files updated by another job: results/8-humas_annot/T2T15_live_stv.bed
    wildcards: sm=T2T15
    resources: mem_mb=8000, mem_mib=7630, disk_mb=1000, disk_mib=954, tmpdir=/tmp, mem=8GB
Shell command: 
        { join -t "$(printf '\t')" <(sort -k1 results/final/bed/T2T15_complete_cens.bed) <(sort -k1 results/8-nucflag/T2T15_status.bed) |         sort -k1,1 -k2,2n -u         | bedtools intersect -u -a - -b results/8-humas_annot/T2T15_live_stv.bed |         awk -v OFS="\t" '{
            adj_name=$1;
            adj_st=$2; adj_end=$3;
            ctg_name=$4;
            ctg_len=$5;
            ort=($1 ~ "rc-") ? "-" : "+";
            ctg_st=$2; ctg_end=$3;
            if (ort == "-") {
                new_ctg_st=ctg_len-ctg_end + 1;
                new_ctg_end=ctg_len-ctg_st + 1;
                ctg_st=new_ctg_st;
                ctg_end=new_ctg_end;
            }
            status=($8 == "good" || $8 == "") ? "good" : "misassembled";
            if (status != "good") {
                next;
            };
            print ctg_name, ctg_st, ctg_end, adj_name, 0, ort, adj_st, adj_end, "0,0,0"
        }' ;} > results/final/bed/T2T15_complete_correct_cens.bed 2> logs/9-get_complete_correct_cens/get_complete_correct_bed_T2T15.log
        
