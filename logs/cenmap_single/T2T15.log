Shell command: 
        cut -f1-3 results/8-cdr_finder/bed/T2T15_CDR.live.bed |         sort -k1,1 |         join - <(cat results/final/bed/T2T15_complete_cens.bed | sort -k1,1) |         awk -v OFS="\t" '{
            if ($2 >= $4 && $3 <= $5) {
                print $1":"$4+1"-"$5, $2,$3
            }
        }' > results/8-cdr_finder/bed/all_cdrs.bed
        sort -k1,1 results/8-cdr_finder/bed/T2T15_methyl_all_merged.bed  |         join - <(cat results/final/bed/T2T15_complete_cens.bed | sort -k1,1) |         awk -v OFS="\t" '{
            if ($2 >= $6 && $3 <= $7) {
                print $1":"$6+1"-"$7,$2,$3,$4,$5
            }
        }' > results/8-cdr_finder/bed/all_binned_freq.bed
        
