            dataset=unique_datasets["apk"],
        )


rule collect_qc_benchmark:
    input:
        **qc_collection(
            asm_benchmark,
            methods_unphased=["unphased_verkko", "phased_verkko"],
            methods_phased=["phased_verkko", "phased_gfase"],
        ),
    output:
        tsv="assembly/qc/qc_benchmark.tsv",
    conda:
        "env/R.yml"
    log:
        "logs/collect_qc.log",
    script:
        "scripts/06_collect_qc.R"


