        expand("assembly/variants/{asm}/small_variants.dip.vcf.gz", asm = asm.keys()),
        expand("assembly/variants/{asm}/hapdiff_phased.vcf.gz", asm = asm.keys()),
        expand("assembly/qc/{asm}/whatshap_compare.tsv", asm = asm.keys()),
        expand("assembly/qc/{asm}/whatshap_stats.tsv", asm = asm.keys()),
        bam_qc,
        expand("assembly/output/{dataset}/assembly.fasta", dataset=asm.keys()),
        expand("assembly/qc/{dataset}/bandage_graph.png", dataset=asm.keys()),
        expand(
            "assembly/qc/{dataset}/qc_paftools_{module}.{hp}.txt",
            dataset=asm.keys(),
            module=["stat", "asmstat", "asmgene"],
            hp=["haplotype1", "haplotype2"],
        ),
