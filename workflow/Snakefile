# Data subgroups

## Create subset of datasets for benchmarking, published dataset only

datasets_benchmark = {key: datasets[key] for key in ["published"]}
asm_benchmark = {k: v for k, v in asm.items() if v["dataset"] == "published"}

## Create subset of assemblies for reduced flowcell number
asm_flowcells = [
    "TUE_02_01UL",
    "TUE_02_02UL",
    "TUE_02_03UL",
    "TUE_02_04UL",
    "TUE_02_05UL",
    "TUE_02_06UL",
    "TUE_02_01UL_01DX",
    "TUE_02_02UL_01DX",
    "TUE_02_03UL_01DX",
    "TUE_02_04UL_01DX",
    "TUE_02_05UL_01DX",
    "TUE_02_06UL_01DX",
    "TUE_02_01UL_02DX",
    "TUE_02_02UL_02DX",
    "TUE_02_03UL_02DX",
    "TUE_02_04UL_02DX",
    "TUE_02_05UL_02DX",
    "TUE_02_06UL_02DX",
]

asm_flowcells = {k: v for k, v in asm.items() if k in asm_flowcells}

## All other assemblies are "real" samples
asm_samples = {
    k: v for k, v in asm.items() if k not in (asm_flowcells.keys() | asm_benchmark.keys())
}


print("Benchmark assemblies:")
print(asm_benchmark)

print("Flowcell number assemblies:")
print(asm_flowcells)

print("Real sample assemblies:")
print(asm_samples)
print("----------------------------------------------------------")

# Create QC for all input FASTQ files
fq_files = [
    item for x in asm for item in get_assembly_input(SimpleNamespace(**{"asm": x})).values()
]
fq_qc = [
    x.replace("/input/", "/input_qc/").replace(".fastq.gz", "/read_stats.txt")
    for x in fq_files
]

# Create BAMS and mapping QC for all input files
bam_qc = []
for dataset in datasets_benchmark:
    for filetype in datasets_benchmark[dataset]:
        if filetype != "POREC":
            bam_qc.append(
                f"data/bamstats/mapped/{dataset}/{dataset}.{filetype}/bamstats.txt"
            )  # ONT bamstats
            bam_qc.append(
                f"data/bamstats/mapped/{dataset}/{dataset}.{filetype}/cov.mosdepth.summary.txt"
            )  # Coverage
            bam_qc.append(
                f"data/bamstats/mapped/{dataset}/{dataset}.{filetype}/bamqc.tsv.gz"
            )  # Alfred Bamqc

# Include downsampled files for benchmarking
bam_qc += [
    re.sub(
        ".chr\d+.",
        "/",
        x.replace("assembly/input/", "data/bamstats/mapped/").replace(
            ".fastq.gz", "/bamstats.txt"
        ),
    )
    for x in fq_files
    if "POREC" not in x
]

bam_qc += [
    re.sub(
        ".chr\d+.",
        "/",
        x.replace("assembly/input/", "data/bamstats/mapped/").replace(
            ".fastq.gz", "/cov.mosdepth.summary.txt"
        ),
    )
    for x in fq_files
    if "POREC" not in x
]

# Create Dorado summary files for basecalled unmapped bams
for dataset in datasets:
    for entry in datasets[dataset]:
        files = (
            datasets[dataset].get(entry, [])
            if isinstance(datasets[dataset].get(entry), list)
            else [datasets[dataset].get(entry)]
        )
        for e in files:
            if os.path.isdir(e):
                if entry == "UL":
                    bam_qc.append(
                        f"data/bamstats/basecalled/SUP/{os.path.basename(e)}/{os.path.basename(e)}.sup.sequencing_summary.processed.txt"
                    )
                elif entry == "HQ_duplex":
                    bam_qc.append(
                        f"data/bamstats/basecalled/Duplex/{os.path.basename(e)}/{os.path.basename(e)}.duplex.sequencing_summary.processed.txt"
                    )
            else:
                print("Not included in BAM QC:", e)


# Make different sets for assembly with and without POREC
asm_with_porec = [x for x in asm.keys() if "POREC" in datasets[asm[x]["dataset"]]]
asm_without_porec = [x for x in asm.keys() if "POREC" not in datasets[asm[x]["dataset"]]]
asm_samples_phased = [
    x for x in asm_samples.keys() if "POREC" in datasets[asm[x]["dataset"]]
]
asm_samples_unphased = [
    x for x in asm_samples.keys() if "POREC" not in datasets[asm[x]["dataset"]]
]

# Initialize dictionaries with sets
unique_datasets = {"sup": {}, "herro": {}, "duplex": {}, "porec": {}}

# Create dict with unique datasets for run folder lookup
for dataset_set in datasets.keys():
    for data_type in datasets[dataset_set]:
        for run_folder in datasets[dataset_set][data_type]:
            # Check if path exists and starts with correct prefix
            if os.path.isdir(run_folder) and run_folder.startswith("data/raw"):
                # Get the leaf folder name
                leaf_folder = os.path.basename(run_folder)

                if data_type == "UL":
                    unique_datasets["sup"][leaf_folder] = run_folder
                elif data_type == "HQ_herro":  # Herro needs to be SUP basecalled first
                    unique_datasets["sup"][leaf_folder] = run_folder
                    unique_datasets["herro"][leaf_folder] = run_folder
                elif data_type == "HQ_duplex":
                    unique_datasets["duplex"][leaf_folder] = run_folder
                elif data_type == "POREC":
                    unique_datasets["sup"][leaf_folder] = run_folder

print("-----------")
print("Unique datasets:")
print(unique_datasets)


rule all:
    input:
        # QC Files
        #fq_qc,
        #bam_qc,
        # Assembly Files
        expand("assembly/output/verkko/{dataset}/assembly.fasta", dataset=asm.keys()),
        # Assembly QC Files (Unphased, no POREC)
        expand(
            "assembly/qc/unphased_verkko/{dataset}/bandage_graph.png",
            dataset=asm_without_porec,
        ),
        expand(
            "assembly/qc/unphased_verkko/{asm}/merqury.qv",
            asm=asm_without_porec,
        ),
        expand(
            "assembly/qc/unphased_verkko/{asm}/T2T_contigs.unphased.seqinfo.txt",
            asm=asm_without_porec,
        ),
        expand(
            "assembly/qc/unphased_verkko/{asm}/qc_paftools_{module}.unphased.txt",
            asm=asm_without_porec,
            module=["asmgene", "asmstat", "stat"],
        ),
        expand(
            "assembly/qc/unphased_verkko/{asm}/colors.tsv",
            asm=asm_without_porec,
        ),
        expand(
            "assembly/qc/unphased_verkko/{asm}/assembly_graph.gfa",
            asm=asm_without_porec,
        ),
        # Assembly QC Files (Phased)
        expand(
            "assembly/qc/phased_{tool}/{dataset}/dotplot.{hp}.pdf",
            dataset=asm_with_porec,
            tool=["verkko"],
            hp=["haplotype1", "haplotype2"],
        ),
        expand(
            "assembly/qc/phased_{tool}/{dataset}/bandage_graph.png",
            dataset=asm_with_porec,
            tool=["verkko"],
        ),
        expand(
            "assembly/qc/phased_{tool}/{asm}/T2T_contigs.{hp}.seqinfo.txt",
            asm=asm_with_porec,
            tool=["verkko"],
            hp=["haplotype1", "haplotype2"],
        ),
        # Variant Calling
        expand(
            "assembly/variants/{asm}/phased_{tool}/small_variants.dip.vcf.gz",
            asm=asm_with_porec,
            tool=["verkko"],
        ),
        expand(
            "assembly/variants/{asm}/phased_{tool}/hapdiff_phased.vcf.gz",
            asm=asm_with_porec,
            tool=["verkko"],
        ),
        # Merged QC:
        "assembly/qc/qc_samples.tsv",


