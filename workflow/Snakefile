# Create Dorado summary files for basecalled unmapped bams
for dataset in datasets:
    for entry in datasets[dataset]:
        files = (
            datasets[dataset].get(entry, [])
            if isinstance(datasets[dataset].get(entry), list)
            else [datasets[dataset].get(entry)]
        )
        for e in files:
            if os.path.isdir(e):
                if entry == "UL":
                    bam_qc.append(
                        f"data/bamstats/basecalled/sup/{os.path.basename(e)}/{os.path.basename(e)}.sup.sequencing_summary.processed.txt"
                    )
                elif entry == "HQ_duplex":
                    bam_qc.append(
                        f"data/bamstats/basecalled/Duplex/{os.path.basename(e)}/{os.path.basename(e)}.duplex.sequencing_summary.processed.txt"
                    )
            else:
                print("Not included in BAM QC:", e)

print("----------------------------------------------------------")

# Initialize dictionaries with empty sets
unique_datasets = {"sup": {}, "herro": {}, "duplex": {}, "porec": {}, "apk": {}	}

# Track original paths for conflict detection
path_tracking = {}

# Create dict with unique datasets for run folder lookup
for dataset_set in datasets.keys():
    for data_type in datasets[dataset_set]:
        for run_folder in datasets[dataset_set][data_type]:
            # Check if path exists and starts with correct prefix
            if os.path.isdir(run_folder) and run_folder.startswith("data/raw"):
                # Get the leaf folder name
                leaf_folder = os.path.basename(run_folder)
                # Skip empty folder names
                if leaf_folder == "":
                    print(f"Warning: Empty folder name found in {run_folder}, skipping")
                    continue

                # Function to add to unique_datasets with conflict resolution
                def add_to_unique_datasets(data_type_key, leaf_folder, run_folder):
                    original_leaf = leaf_folder
                    suffix = 1

                    # Check for conflicts and resolve with suffix
                    while leaf_folder in unique_datasets[data_type_key]:
                        existing_path = unique_datasets[data_type_key][leaf_folder]
                        if existing_path != run_folder:
                            print(f"Warning: Duplicate run folder name '{original_leaf}' found!")
                            print(f"  Existing: {existing_path}")
                            print(f"  New: {run_folder}")
                            print(f"  Adding suffix '_{suffix}' to new entry")
                            leaf_folder = f"{original_leaf}_{suffix}"
                            suffix += 1
                        else:
                            # Same path, no conflict
                            break

                    unique_datasets[data_type_key][leaf_folder] = run_folder

                    # Track for cross-type conflicts
                    if run_folder in path_tracking:
                        path_tracking[run_folder].append((data_type_key, leaf_folder))
                    else:
                        path_tracking[run_folder] = [(data_type_key, leaf_folder)]

                    return leaf_folder

                if data_type == "UL":
                    add_to_unique_datasets("sup", leaf_folder, run_folder)
                elif data_type == "HQ_herro":  # Herro needs to be sup basecalled first
                    final_leaf = add_to_unique_datasets("sup", leaf_folder, run_folder)
                    add_to_unique_datasets("herro", final_leaf, run_folder)
                elif data_type == "HQ_duplex":
                    add_to_unique_datasets("duplex", leaf_folder, run_folder)
                elif data_type == "POREC":
                    final_leaf = add_to_unique_datasets("sup", leaf_folder, run_folder)
                    add_to_unique_datasets("porec", final_leaf, run_folder)
                elif data_type == "APK":
                    add_to_unique_datasets("apk", leaf_folder, run_folder)

# Check for cross-type conflicts (same path mapped to different run IDs across types)
for run_folder, mappings in path_tracking.items():
    if len(set(mapping[1] for mapping in mappings)) > 1:
        print(f"Warning: Path '{run_folder}' is mapped to different run IDs across data types:")
        for data_type, run_id in mappings:
            print(f"  {data_type}: {run_id}")

print("Unique datasets:")
print(unique_datasets)

### Create collections of QC files. Specify assemblies and assembly methods that should be included.
def qc_collection(
    asm, methods_unphased=["unphased_verkko"], methods_phased=["phased_verkko"], haplotypes = ["haplotype1", "haplotype2", "both"]
):
    results_unphased = {}
    results_phased = {}
    results = {}
    results_stats = {}

    if methods_unphased:
        results_unphased = {
                # QV for diploid assembly (merqury)
                "merqury_stats": expand(
                    "assembly/qc/{method}/{asm}/merqury.qv",
                    asm=asm,
                    method=methods_unphased,
                ),
                # Number of detected T2T contigs, unphased assembly
                "findt2t_alignment": expand(
                    "assembly/qc/{method}/{asm}/T2T_contigs.unphased_alignment_T2T.txt",
                    asm=asm,
                    method=methods_unphased,
                ),
                "findt2t_motif": expand(
                    "assembly/qc/{method}/{asm}/T2T_contigs.unphased_alignment_T2T.txt",
                    asm=asm,
                    method=methods_unphased,
                ),
                # PAF stats
                "paf_stat": expand(
                    "assembly/qc/{method}/{asm}/qc_paftools_stat.unphased.txt",
                    asm=asm,
                    method=methods_unphased,
                ),
                "paf_asmstat": expand(
                    "assembly/qc/{method}/{asm}/qc_paftools_asmstat.unphased.txt",
                    asm=asm,
                    method=methods_unphased,
                ),
                "paf_asmgene": expand(
                    "assembly/qc/{method}/{asm}/qc_paftools_asmgene.unphased.txt",
                    asm=asm,
                    method=methods_unphased,
                ),
                "sex": expand(
                    "assembly/qc/{method}/{asm}/sample_sex.txt",
                    asm=asm,
                    method=methods_unphased,
                ),
                "gap_stats": expand(
                    "assembly/qc/{method}/{asm}/gap_stats.unphased.n_stats.tsv",
                    asm=asm,
                    method=methods_unphased,
                ),
            }


    # Count number of files in each category
    for key, files in results_unphased.items():
        if isinstance(files, list):
            if "unphased" not in results_stats:
                results_stats["unphased"] = {}
            results_stats["unphased"][key] = len(files)

        if key not in results:
            results[key] = files
        else:
            # Assuming the values are lists, concatenate them
            if isinstance(results[key], list) and isinstance(files, list):
                results[key].extend(files)
            else:
                print(f"Warning: Unexpected value type for {key} in QC collection")

    if methods_phased:
        if "both" in haplotypes:
            results_phased = {
                # Merqury stats are special (Also account for polished/unpolished and are managed inside the QC re)
                "merqury_stats": expand(
                    "assembly/qc/{method}/{asm}/merqury.qv",
                    asm=asm,
                    method=methods_phased,
                ),
            }

        # Rules valid for "hap1" and  "hap2"
        if "haplotype1" in haplotypes and "haplotype2" in haplotypes:
            results_phased.update({
                "whatshap_stats": expand(
                    "assembly/qc/{method}/{asm}/whatshap_stats.tsv",
                    asm=asm,
                    method=methods_phased,
                ),
                "whatshap_compare": expand(
                    "assembly/qc/{method}/{asm}/whatshap_compare.tsv",
                    asm=asm,
                    method=methods_phased,
                ),
                "paf_asmgene": expand(
                    "assembly/qc/{method}/{asm}/qc_paftools_asmgene.{hp}.txt",
                    asm=asm,
                    method=methods_phased,
                    hp=["haplotype1", "haplotype2"],
                ),
                "merqury_hap_stats": expand(
                    "assembly/qc/{method}/{asm}/merqury.{hp}.qv",
                    asm=asm,
                    method=methods_phased,
                    hp=["haplotype1", "haplotype2"],
                ),
            })

        # Rules valid for "hap1", "hap2" and "both"
        results_phased.update({
            "paf_stat": expand(
                "assembly/qc/{method}/{asm}/qc_paftools_stat.{hp}.txt",
                asm=asm,
                method=methods_phased,
                hp=haplotypes,
            ),
            "paf_asmstat": expand(
                "assembly/qc/{method}/{asm}/qc_paftools_asmstat.{hp}.txt",
                asm=asm,
                method=methods_phased,
                hp=haplotypes,
            ),
            "paf_misjoin": expand(
                "assembly/qc/{method}/{asm}/qc_paftools_misjoin.{hp}.txt",
                asm=asm,
                method=methods_phased,
                hp=haplotypes,
            ),

            "findt2t_alignment": expand(
                "assembly/qc/{method}/{asm}/T2T_contigs.{hp}_alignment_T2T.txt",
                asm=asm,
                method=methods_phased,
                hp=haplotypes,
            ),
            "findt2t_motif": expand(
                "assembly/qc/{method}/{asm}/T2T_contigs.{hp}_alignment_T2T.txt",
                asm=asm,
                method=methods_phased,
                hp=haplotypes,
            ),
            "gap_stats": expand(
                "assembly/qc/{method}/{asm}/gap_stats.{hp}.n_stats.tsv",
                asm=asm,
                method=methods_phased,
                hp=haplotypes,
            ),
            "contig_stats": expand(
                "assembly/qc/{method}/{asm}/contig_stats.{hp}.tsv",
                asm=asm,
                method=methods_phased,
                hp=haplotypes
            )
        })

    for key, files in results_phased.items():
        if isinstance(files, list):
            if "phased" not in results_stats:
                results_stats["phased"] = {}
            results_stats["phased"][key] = len(files)

        if key not in results:
            results[key] = files
        else:
            # Assuming the values are lists, concatenate them
            if isinstance(results[key], list) and isinstance(files, list):
                results[key].extend(files)
            else:
                print(f"Warning: Unexpected value type for {key} in QC collection")

    # Print summary of QC files being collected
    for key, files in results.items():
        if isinstance(files, list):
            if "total" not in results_stats:
                results_stats["total"] = {}
            results_stats["total"][key] = len(files)

    print(f"\nAssembly QC Collection for samples: {', '.join(asm)}")
    for key, files in results_stats.items():
        print(f"{key}:")
        print(f"    {files}")

    return results


