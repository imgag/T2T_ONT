import glob
import yaml
import re
from types import SimpleNamespace


configfile: os.path.join(workflow.basedir, "config.yml")


with open("data/datasets.yml") as f:
    datasets = yaml.safe_load(f)

with open("assembly/assemblies.yml") as f:
    asm = yaml.safe_load(f)

include: "rules/handle_gpu.smk"
include: "rules/basecalling.smk"
include: "rules/data_preparation.smk"
include: "rules/error_correction.smk"
include: "rules/qc_input.smk"
include: "rules/assembly.smk"
include: "rules/qc_assembly.smk"
include: "rules/call_variants.smk"


# Create subset of datasets for benchmarking
datasets_benchmark = {key: datasets[key] for key in ["published"]}

# Create QC for all input FASTQ files
fq_files = [
    item
    for x in asm
    for item in get_assembly_input(SimpleNamespace(**{"asm": x})).values()
]
fq_qc = [
    x.replace("/input/", "/input_qc/").replace(".fastq.gz", "/read_stats.txt")
    for x in fq_files
]


# Create BAMS and mapping QC for all input files
bam_qc = []
for dataset in datasets_benchmark:
    for filetype in datasets_benchmark[dataset]:
        if filetype != "POREC":
            bam_qc.append(
                f"data/bamstats/mapped/{dataset}/{dataset}.{filetype}/bamstats.txt"
            )  # ONT bamstats
            bam_qc.append(
                f"data/bamstats/mapped/{dataset}/{dataset}.{filetype}/cov.mosdepth.summary.txt"
            )  # Coverage
            bam_qc.append(
                f"data/bamstats/mapped/{dataset}/{dataset}.{filetype}/bamqc.tsv.gz"
            )  # Alfred Bamqc
# ## Include downsampled files for benchmarking
bam_qc += [
    re.sub(
        ".chr\d+.",
        "/",
        x.replace("assembly/input/", "data/bamstats/mapped/").replace(
            ".fastq.gz", "/bamstats.txt"
        ),
    )
    for x in fq_files
    if "POREC" not in x
]

bam_qc += [
    re.sub(
        ".chr\d+.",
        "/",
        x.replace("assembly/input/", "data/bamstats/mapped/").replace(
            ".fastq.gz", "/cov.mosdepth.summary.txt"
        ),
    )
    for x in fq_files
    if "POREC" not in x
]

# Create Dorado summary files for basecalled unmapped bams
for dataset in datasets:
    for entry in datasets[dataset]:
        files = (
            datasets[dataset].get(entry, [])
            if isinstance(datasets[dataset].get(entry), list)
            else [datasets[dataset].get(entry)]
        )
        for e in files:
            if os.path.isdir(e):
                if entry == "UL":
                    bam_qc.append(
                        f"data/bamstats/basecalled/SUP/{os.path.basename(e)}/{os.path.basename(e)}.sup.sequencing_summary.processed.txt"
                    )
                elif entry == "HQ_duplex":
                    bam_qc.append(
                        f"data/bamstats/basecalled/Duplex/{os.path.basename(e)}/{os.path.basename(e)}.duplex.sequencing_summary.processed.txt"
                    )
            else:
                print("Not included in BAM QC:", e)


# Make different sets for assembly with and without POREC
asm_with_porec = [x for x in asm.keys() if "POREC" in datasets[asm[x]["dataset"]]]
asm_without_porec = [
    x for x in asm.keys() if "POREC" not in datasets[asm[x]["dataset"]]
]

rule all:
    input:
        # QC Files
        fq_qc,
        bam_qc,
        # Assembly Files
        expand(
            "assembly/output/verkko/{dataset}/assembly.fasta", dataset=asm.keys()
        ),         
        expand(
            "assembly/output/gfase/{dataset}/gfase/chained.gfa", dataset=asm_with_porec
        ),
        # Assembly QC Files (Unphased, no POREC)
        expand(
            "assembly/qc/unphased_verkko/{dataset}/bandage_graph.png",
            dataset=asm_without_porec,
        ),
        expand(
            "assembly/qc/unphased_verkko/{asm}/merqury.qv",
            asm=asm_without_porec,
        ),
        expand(
            "assembly/qc/unphased_verkko/{asm}/T2T_contigs.unphased.seqinfo.txt",
            asm=asm_without_porec,
        ),         
        expand(
            "assembly/qc/unphased_verkko/{asm}/qc_paftools_{module}.unphased.txt",
            asm=asm_without_porec,
            module=["asmgene", "asmstat", "stat"]
        ),
        expand(
            "assembly/qc/unphased_verkko/{asm}/colors.tsv",
            asm=asm_without_porec,
        ),
        expand(
            "assembly/qc/unphased_verkko/{asm}/assembly_graph.gfa",
            asm=asm_without_porec,
        ),
        # Assembly QC Files (Phased)
        expand(
            "assembly/qc/phased_{tool}/{dataset}/dotplot.{hp}.pdf",
            dataset=asm_with_porec,
            tool=["gfase", "verkko"],
            hp=["haplotype1", "haplotype2"],
        ),
        expand(
            "assembly/qc/phased_{tool}/{dataset}/bandage_graph.png",
            dataset=asm_with_porec,
            tool=["gfase", "verkko"],
        ),
        expand(
            "assembly/qc/phased_{tool}/{asm}/T2T_contigs.{hp}.seqinfo.txt",
            asm=asm_with_porec,
            tool=["gfase", "verkko"],
            hp=["haplotype1", "haplotype2"],
        ),
        # Variant Calling
        expand(
            "assembly/variants/{asm}/phased_{tool}/small_variants.dip.vcf.gz",
            asm=asm_with_porec,
            tool=["gfase", "verkko"],
        ),
        expand(
            "assembly/variants/{asm}/phased_{tool}/hapdiff_phased.vcf.gz",
            asm=asm_with_porec,
            tool=["gfase", "verkko"],
        ),

        # Merged QC:
        "assembly/qc/qc_full.tsv"

rule all_unphased:
    input:
        expand("assembly/output/verkko_unphased/{asm}/use_verkko_files.done", asm=asm)

rule all_verkko_phased:
    input:
        expand("assembly/output/verkko/{asm}/assembly.colors.csv", asm=asm_with_porec)

rule collect_qc:
    input:
        paf_stat = expand(
            "assembly/qc/phased_{tool}/{dataset}/qc_paftools_{module}.{hp}.txt",
            dataset=asm_with_porec,
            tool=["gfase", "verkko"],
            module="stat",
            hp=["haplotype1", "haplotype2"],
        ),
        paf_asmstat = expand(
            "assembly/qc/phased_{tool}/{dataset}/qc_paftools_{module}.{hp}.txt",
            dataset=asm_with_porec,
            tool=["gfase", "verkko"],
            module="asmstat",
            hp=["haplotype1", "haplotype2"],
        ),
        paf_asmgene = expand(
            "assembly/qc/phased_{tool}/{dataset}/qc_paftools_{module}.{hp}.txt",
            dataset=asm_with_porec,
            tool=["gfase", "verkko"],
            module="asmgene",
            hp=["haplotype1", "haplotype2"],
        ),
        sex = expand(
            "assembly/qc/phased_{tool}/{dataset}/sample_sex.txt",
            dataset=asm_with_porec,
            tool=["gfase", "verkko"],
        ),
        whatshap_stats = expand(
            "assembly/qc/phased_{tool}/{asm}/whatshap_stats.tsv",
            asm=asm_with_porec,
            tool=["gfase", "verkko"],
        ),
        whatshap_compare = expand(
            "assembly/qc/phased_{tool}/{asm}/whatshap_compare.tsv",
            asm=asm_with_porec,
            tool=["gfase", "verkko"],
        ),
        merqury_stats = expand(
            "assembly/qc/phased_{tool}/{asm}/merqury.qv",
            asm=asm_with_porec,
            tool=["gfase", "verkko"],
        ),
        merqury_hap_stats = expand(
            "assembly/qc/phased_{tool}/{asm}/merqury.{hp}.qv",
            asm=asm_with_porec,
            tool=["gfase", "verkko"],
            hp=["haplotype1", "haplotype2"],
        ),
        findt2t_alignment = expand(
            "assembly/qc/phased_{tool}/{asm}/T2T_contigs.{hp}_alignment_T2T.txt",
            asm=asm_with_porec,
            tool=["gfase", "verkko"],
            hp=["haplotype1", "haplotype2"]
        ),
        findt2t_motif = expand(
            "assembly/qc/phased_{tool}/{asm}/T2T_contigs.{hp}_alignment_T2T.txt",
            asm=asm_with_porec,
            tool=["gfase", "verkko"],
            hp=["haplotype1", "haplotype2"]
        )
    output:
        tsv = "assembly/qc/qc_full.tsv",
    conda:
        "env/R.yml"
    log:
        "logs/collect_qc.log"
    script:
        "scripts/06_collect_qc.R"
