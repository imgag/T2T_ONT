# Create QC for all input FASTQ files
fq_files = [
    item
    for x in asm
    for item in get_assembly_input(SimpleNamespace(**{"asm": x})).values()
]
fq_qc = [
    x.replace("/input/", "/input_qc/").replace(".fastq.gz", "/read_stats.txt")
    for x in fq_files
]

# Create BAMS and mapping QC for all input files
## Before downsampling
bam_qc = []
for dataset in datasets:
    for filetype in datasets[dataset]:
        if filetype != "POREC":
            bam_qc.append(f"data/bamstats/{dataset}/{dataset}.{filetype}/bamstats.txt")             # ONT bamstats
            bam_qc.append(f"data/bamstats/{dataset}/{dataset}.{filetype}/cov.mosdepth.summary.txt") # Coverage
            bam_qc.append(f"data/bamstats/{dataset}/{dataset}.{filetype}/bamqc.tsv.gz")             # Alfred Bamqc

## Include downsampled files
bam_qc += [
    re.sub(".chr\d+.", "/", x.replace("assembly/input/", "data/bamstats/").replace(".fastq.gz", "/bamstats.txt"))
    for x in fq_files if "POREC" not in x
]
bam_qc += [
    re.sub(".chr\d+.", "/", x.replace("assembly/input/", "data/bamstats/").replace(".fastq.gz", "/cov.mosdepth.summary.txt"))
    for x in fq_files if "POREC" not in x
]

