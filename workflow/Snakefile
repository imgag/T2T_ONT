rule all_basecalling:
# This rule just makes the basecalling for raw datasets, no QC, no downstream processing
    input:
        expand(
            "data/basecalled/Duplex/{dataset}/{dataset}.duplexonly.unmapped.bam",
            dataset=unique_datasets["duplex"],
        ),
        expand(
            "data/basecalled/sup/{dataset}/{dataset}.sup.sequencing_summary.txt",
            dataset=unique_datasets["sup"],
# Data subgroups
        ),
        expand(
            "data/corrected/{dataset}/{dataset}.corrected.fasta",
            dataset=unique_datasets["herro"],
        ),
        expand(
            "data/basecalled/apk/{dataset}/{dataset}.apk.unmapped.bam",
            dataset=unique_datasets["apk"],
        )


rule collect_qc_samples:
    input:
        **qc_collection(asm_samples, methods_phased=["phased_verkko"], methods_unphased=[]),
    output:
        tsv="assembly/qc/qc_samples.tsv",
    conda:
        "env/R.yml"
    log:
        "logs/collect_qc.log",
    script:
        "scripts/06_collect_qc.R"




