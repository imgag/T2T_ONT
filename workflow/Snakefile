            asm=asm_benchmark,
            tool=["gfase", "verkko"],
            module="asmstat",
            hp=["haplotype1", "haplotype2"],
        ),
        paf_asmgene=expand(
            "assembly/qc/phased_{tool}/{asm}/qc_paftools_{module}.{hp}.txt",
            asm=asm_benchmark,
            tool=["gfase", "verkko"],
            module="asmgene",
            hp=["haplotype1", "haplotype2"],
        ),
        sex=expand(
            "assembly/qc/phased_{tool}/{asm}/sample_sex.txt",
            asm=asm_benchmark,
            tool=["gfase", "verkko"],
        ),
        whatshap_stats=expand(
            "assembly/qc/phased_{tool}/{asm}/whatshap_stats.tsv",
            asm=asm_benchmark,
            tool=["gfase", "verkko"],
        ),
        whatshap_compare=expand(
            "assembly/qc/phased_{tool}/{asm}/whatshap_compare.tsv",
            asm=asm_benchmark,
            tool=["gfase", "verkko"],
        ),
        merqury_stats=expand(
            "assembly/qc/phased_{tool}/{asm}/merqury.qv",
            asm=asm_benchmark,
            tool=["gfase", "verkko"],
        ),
        merqury_hap_stats=expand(
