rule determine_sex:
    input: data/mapped/T2T02/T2T02.UL.70x.ref.bam
    output: assembly/qc/phased_verkko/T2T02/sample_sex.txt
    log: logs/determine_sex_phased_verkko_T2T02.log
    jobid: 781
    reason: Missing output files: assembly/qc/phased_verkko/T2T02/sample_sex.txt
    wildcards: isphased=phased, tool=verkko, asm=T2T02
    resources: tmpdir=<TBD>
Shell command: 
        # Calculate X chromosome coverage
        mosdepth -n --by 10000 --fast-mode --chrom chrX             $(dirname assembly/qc/phased_verkko/T2T02/sample_sex.txt)/$(basename assembly/qc/phased_verkko/T2T02/sample_sex.txt.tmp.X) data/mapped/T2T02/T2T02.UL.70x.ref.bam 2>logs/determine_sex_phased_verkko_T2T02.log

        # Calculate Y chromosome coverage 
        mosdepth -n --by 10000 --fast-mode --chrom chrY             $(dirname assembly/qc/phased_verkko/T2T02/sample_sex.txt)/$(basename assembly/qc/phased_verkko/T2T02/sample_sex.txt.tmp.Y) data/mapped/T2T02/T2T02.UL.70x.ref.bam 2>>logs/determine_sex_phased_verkko_T2T02.log

        # Get mean coverage for X and Y
        X_cov=$(zcat $(dirname assembly/qc/phased_verkko/T2T02/sample_sex.txt)/$(basename assembly/qc/phased_verkko/T2T02/sample_sex.txt.tmp.X.regions.bed.gz) |             awk '{sum+=$4} END {print sum/NR}')
        Y_cov=$(zcat $(dirname assembly/qc/phased_verkko/T2T02/sample_sex.txt)/$(basename assembly/qc/phased_verkko/T2T02/sample_sex.txt.tmp.Y.regions.bed.gz) |             awk '{sum+=$4} END {print sum/NR}')

        # Determine sex based on Y/X ratio
        # Ratio > 0.5 indicates male
        ratio=$(echo "scale=3; $Y_cov/$X_cov" | bc)
        if (( $(echo "$ratio > 0.5" | bc -l) )); then
            echo "male	${ratio}" > assembly/qc/phased_verkko/T2T02/sample_sex.txt
        else
            echo "female	${ratio}" > assembly/qc/phased_verkko/T2T02/sample_sex.txt
