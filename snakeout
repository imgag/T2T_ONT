rule filter_shared_variants:
    input: data/ref/CHM13v2.0_HG2-T2TQ100-V1.1.vcf.gz, assembly/variants/T2T02/phased_verkko/small_variants.dip.vcf.gz
    output: assembly/qc/phased_verkko/T2T02/giab.filtered.vcf.gz, assembly/qc/phased_verkko/T2T02/assembly.filtered.vcf.gz
    log: logs/filter_shared_variants/verkko_T2T02.log
    jobid: 857
    reason: Missing output files: assembly/qc/phased_verkko/T2T02/assembly.filtered.vcf.gz, assembly/qc/phased_verkko/T2T02/giab.filtered.vcf.gz; Input files updated by another job: assembly/variants/T2T02/phased_verkko/small_variants.dip.vcf.gz
    wildcards: tool=verkko, asm=T2T02
    resources: tmpdir=<TBD>
Shell command: 
        # Extract shared variants and normalize sample names
        temp_ref=$(mktemp)
        temp_asm=$(mktemp)

        bcftools view -t ^chrX,^chrY data/ref/CHM13v2.0_HG2-T2TQ100-V1.1.vcf.gz |         bcftools reheader --samples <(echo "SAMPLE") |         bgzip > "$temp_ref" &&         bcftools index "$temp_ref"

        bcftools view -t ^chrX,^chrY assembly/variants/T2T02/phased_verkko/small_variants.dip.vcf.gz |         bcftools reheader --samples <(echo "SAMPLE") |         bgzip > "$temp_asm" &&         bcftools index "$temp_asm"

        # Get intersection of variants
        bcftools isec -n=2 -w1 "$temp_ref" "$temp_asm" |         bcftools view -Oz > assembly/qc/phased_verkko/T2T02/giab.filtered.vcf.gz

        bcftools isec -n=2 -w1 "$temp_asm" "$temp_ref" |         bcftools view -Oz > assembly/qc/phased_verkko/T2T02/assembly.filtered.vcf.gz

        # Clean up temp files
        rm "$temp_ref" "$temp_asm"

        # Index output files
        bcftools index assembly/qc/phased_verkko/T2T02/giab.filtered.vcf.gz
        bcftools index assembly/qc/phased_verkko/T2T02/assembly.filtered.vcf.gz
        

